or {
  or {
    `$db.insert($table)` where {
      $table <: or {
        `order`,
        `loadingPlace`,
        `unloadingPlace`
      }
    },
    `$db.update($table)` where {
      $table <: or {
        `order`,
        `loadingPlace`,
        `unloadingPlace`,
        `truck`
      }
    },
    `$db.delete($table)` where {
      $table <: or {
        `order`,
        `loadingPlace`,
        `unloadingPlace`
      }
    }
  } as $call where {
    $filename <: not or {
      r".*lib/services/orders\.services\.ts",
      r".*__tests__/.*",
      r".*db/seeds/.*"
    },
    register_diagnostic(span=$call, message="Write Orders, their Places and a Truck's Driver through the Orders module in @/lib/services/orders.services.")
  },
  or {
    `$db.insert($table)`,
    `$db.update($table)`,
    `$db.delete($table)`
  } as $call where {
    $table <: `customer`,
    $filename <: not or {
      r".*lib/services/customer\.services\.ts",
      r".*__tests__/.*",
      r".*db/seeds/.*"
    },
    register_diagnostic(span=$call, message="Write Customers through @/lib/services/customer.services.")
  },
  or {
    `$db.insert($table)`,
    `$db.update($table)`,
    `$db.delete($table)`
  } as $call where {
    $table <: `city`,
    $filename <: not or {
      r".*lib/services/city\.services\.ts",
      r".*__tests__/.*",
      r".*db/seeds/.*"
    },
    register_diagnostic(span=$call, message="Write Cities through @/lib/services/city.services.")
  }
}
