or {
  `$x.toFixed($_)`,
  `Number($a) * Number($b)`
} as $call where {
  $filename <: not or {
    r".*lib/exchange-rate\.ts",
    r".*__tests__/.*"
  },
  register_diagnostic(span=$call, message="Work out a PLN Price with toPricePLN from @/lib/exchange-rate: floating point loses half a grosz.")
}
