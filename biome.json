{
  "$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "maxSize": 1048576,
    "includes": [
      "**",
      "!**/db/migrations/**",
      "!**/components/ui/**",
      "!**/public/mockServiceWorker.js"
    ]
  },
  "plugins": [
    "./biome-plugins/company-today.grit",
    "./biome-plugins/cache-tag-constant.grit",
    "./biome-plugins/calendar-day-click.grit"
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "useBiomeIgnoreFolder": "off",
        "noShadowRestrictedNames": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "date-fns": {
                "importNames": [
                  "isToday",
                  "isTomorrow",
                  "isYesterday",
                  "isFuture",
                  "isPast",
                  "startOfToday",
                  "endOfToday",
                  "startOfTomorrow",
                  "startOfYesterday",
                  "isThisWeek",
                  "isThisMonth",
                  "isThisYear"
                ],
                "message": "Reads the machine's clock; use the Warsaw helpers in @/lib/dates."
              }
            }
          }
        }
      }
    }
  }
}
